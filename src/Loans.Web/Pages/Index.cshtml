@page
@model IndexModel
@{
    ViewData["Title"] = Model.Heading;
}

@switch (Model.View)
{
    case DashboardView.Borrower:
        <partial name="_BorrowerDashboard" model="Model" />
        break;
    case DashboardView.OfficerPipeline:
        <h1 class="h3 mb-3">@Model.Heading</h1>
        <partial name="_OfficerPipeline" model="Model.Pipeline" />
        <partial name="_PortfolioSnapshot" model="Model.Summary" />
        break;
    case DashboardView.UnderwritingQueue:
        <h1 class="h3 mb-3">@Model.Heading</h1>
        <partial name="_UnderwritingQueue" model="Model.Queue" />
        <partial name="_PortfolioSnapshot" model="Model.Summary" />
        break;
    default:
        <h1 class="h3 mb-3">@Model.Heading</h1>
        <partial name="_PortfolioOverview" model="Model.Summary" />
        <section class="mt-4" data-testid="users-link">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h5 mb-1">Users &amp; roles</h2>
                        <p class="text-body-secondary mb-0">See who has access and what each role can do through Claude.</p>
                    </div>
                    <a asp-page="/Admin/Users" class="btn btn-outline-primary">View users</a>
                </div>
            </div>
        </section>
        break;
}
