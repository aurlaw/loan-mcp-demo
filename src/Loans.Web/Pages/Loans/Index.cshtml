@page
@model IndexModel
@{
    ViewData["Title"] = "Loans";
}

<h1 class="h3 mb-3">Loans</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="Loan # or borrower name" aria-label="Search" />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select" aria-label="Status">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<LoanStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@Formatting.Humanize(s)</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="product" class="form-select" aria-label="Product">
            <option value="">All products</option>
            @foreach (var p in Enum.GetValues<LoanProduct>())
            {
                <option value="@p" selected="@(Model.Product == p)">@Formatting.Humanize(p)</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
        <a asp-page="/Loans/Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-hover table-sm align-middle">
    <thead>
        <tr>
            <th>Loan #</th><th>Borrower</th><th>Product</th>
            <th class="num">Original</th><th class="num">Balance</th><th class="num">Rate</th>
            <th>Maturity</th><th>Status</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var l in Model.Results.Items)
    {
        <tr>
            <td><a asp-page="/Loans/Details" asp-route-id="@l.Id">@l.LoanNumber</a></td>
            <td>@l.BorrowerName</td>
            <td>@Formatting.Humanize(l.Product)</td>
            <td class="num">@Formatting.Money(l.OriginalPrincipalCents)</td>
            <td class="num">@Formatting.Money(l.CurrentBalanceCents)</td>
            <td class="num">@Formatting.Rate(l.RateBps)</td>
            <td>@Formatting.Date(l.MaturityDate)</td>
            <td><partial name="_StatusBadge" model="l.Status" /></td>
        </tr>
    }
    </tbody>
</table>

<partial name="_Pager" model="Model.Pager" />
