@model OfficerPipeline
<section data-testid="officer-pipeline">
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var (status, count) in Model.CountsByStatus)
        {
            <a asp-page="/Applications/Index" asp-route-status="@status" class="card text-decoration-none" style="min-width: 10rem">
                <div class="card-body py-2">
                    <div><partial name="_StatusBadge" model="status" /></div>
                    <div class="stat-value" data-testid="pipeline-@status">@count</div>
                </div>
            </a>
        }
    </div>

    <h2 class="h5">Assigned applications</h2>
    @if (Model.Applications.Count == 0)
    {
        <p class="text-body-secondary">No applications assigned to you.</p>
    }
    else
    {
        <table class="table table-hover table-sm align-middle">
            <thead><tr><th>Borrower</th><th>Purpose</th><th class="num">Requested</th><th>Submitted</th><th>Status</th><th>Recommendation</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Applications)
            {
                <tr>
                    <td><a asp-page="/Applications/Details" asp-route-id="@a.Id">@a.BorrowerName</a></td>
                    <td>@a.Purpose</td>
                    <td class="num">@Formatting.Money(a.RequestedAmountCents)</td>
                    <td>@Formatting.Date(a.SubmittedOn)</td>
                    <td><partial name="_StatusBadge" model="a.Status" /></td>
                    <td>
                        @if (a.Recommendation is { } rec) { <partial name="_StatusBadge" model="rec" /> }
                        else { <span class="text-body-secondary">—</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
