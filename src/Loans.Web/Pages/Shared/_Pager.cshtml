@model Pager
<div class="d-flex justify-content-between align-items-center mt-2">
    <small class="text-body-secondary">
        @if (Model.TotalCount == 0)
        {
            <text>No results</text>
        }
        else
        {
            <text>Showing @Model.FirstItem–@Model.LastItem of @Model.TotalCount</text>
        }
    </small>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="@Model.PagePath" asp-all-route-data="Model.RouteFor(Model.Page - 1)">Previous</a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-page="@Model.PagePath" asp-all-route-data="Model.RouteFor(p)">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="@Model.PagePath" asp-all-route-data="Model.RouteFor(Model.Page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
