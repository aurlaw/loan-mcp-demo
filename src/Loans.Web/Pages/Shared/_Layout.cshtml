@using System.Security.Claims
@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirst(LoansClaimTypes.DisplayName)?.Value ?? User.Identity?.Name;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var currentPath = Context.Request.Path.Value ?? "/";
    string NavClass(string prefix) =>
        (prefix == "/" ? currentPath == "/" : currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            ? "nav-link active fw-semibold" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loans MCP Demo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Loans.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Loans MCP Demo</a>
                @if (isSignedIn)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="@NavClass("/")" asp-page="/Index">Dashboard</a></li>
                            <li class="nav-item"><a class="@NavClass("/Loans")" asp-page="/Loans/Index">Loans</a></li>
                            <li class="nav-item"><a class="@NavClass("/Applications")" asp-page="/Applications/Index">Applications</a></li>
                            @if (User.IsInRole(SeedRoles.Admin))
                            {
                                <li class="nav-item"><a class="@NavClass("/Admin")" asp-page="/Admin/Users">Users</a></li>
                            }
                        </ul>
                        <div class="d-flex align-items-center gap-2 text-light">
                            <span data-testid="display-name">@displayName</span>
                            @if (role is not null)
                            {
                                <span class="badge text-bg-light" data-testid="role">@Formatting.Humanize(role)</span>
                            }
                            <form method="post" asp-page="/Account/Logout" class="ms-2">
                                <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Loans MCP Demo · Demo data only
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
