{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Loans": "Data Source=loans.db"
  },
  "Database": {
    "ResetOnStartup": false
  },
  "OAuth": {
    "Issuer": "https://loans.aurlaw.dev",
    "McpResource": "https://loans.aurlaw.dev/mcp",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 14,
    "Cimd": {
      "Enabled": true,
      "FetchTimeoutSeconds": 5,
      "MaxDocumentBytes": 16384,
      "MinCacheMinutes": 5,
      "MaxCacheHours": 24
    },
    "Clients": {}
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5080"
      }
    }
  },
  "AllowedHosts": "*"
}
